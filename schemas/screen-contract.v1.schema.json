{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapcue.dev/schemas/screen-contract.v1.schema.json",
  "title": "MapCue screen contract (mapcue.screen-contract/1)",
  "description": "A versioned contract of one logical screen in one comparison group (app, platform, build, locale), built from the store by `mapcue contract build` (architecture §6, §14, STEP-08). contentHash is the SHA-256 of the compact JSON with version 0 and an empty contentHash; a new version is stored only when it changes. Accessibility cells are typed per evidence level: an `inspected` cell can never be `pass` (architecture §14.1), `assistiveVerified` comes only from manual records of the operator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "screenId", "screenKey", "displayName", "version", "contentHash", "group", "fingerprintVersion", "states", "contexts", "elements", "variants", "accessibility", "keyboard", "evidenceIds"],
  "properties": {
    "schemaVersion": { "const": "mapcue.screen-contract/1" },
    "screenId": { "$ref": "#/$defs/id" },
    "screenKey": { "$ref": "#/$defs/id" },
    "displayName": { "anyOf": [{ "type": "string", "maxLength": 200 }, { "type": "null" }] },
    "version": { "type": "integer", "minimum": 1 },
    "contentHash": { "$ref": "#/$defs/sha256" },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groupKey", "appId", "platform", "appBuildId", "locale"],
      "properties": {
        "groupKey": { "type": "string", "minLength": 1, "maxLength": 600 },
        "appId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "platform": { "enum": ["Android", "Ios"] },
        "appBuildId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "locale": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "fingerprintVersion": { "type": "integer", "minimum": 1 },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stateId", "stateKind", "identityHash", "contextIds"],
        "properties": {
          "stateId": { "$ref": "#/$defs/id" },
          "stateKind": { "enum": ["Default", "Loading", "Empty", "Error", "Modal", "Menu", "Form", "Keyboard", "Unknown"] },
          "identityHash": { "$ref": "#/$defs/sha256" },
          "contextIds": { "$ref": "#/$defs/ids" }
        }
      }
    },
    "contexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contextId", "profileId", "scenarioId", "capabilities"],
        "properties": {
          "contextId": { "$ref": "#/$defs/id" },
          "profileId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "scenarioId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "capabilities": { "type": "array", "items": { "type": "string", "maxLength": 128 } }
        }
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["elementKey", "keyStrength", "role", "roleLevel", "label", "resourceId", "interactive", "keyboardTarget", "presence", "visibleWhen"],
        "properties": {
          "elementKey": { "$ref": "#/$defs/text" },
          "keyStrength": { "enum": ["ResourceId", "Label", "Structural"] },
          "role": { "type": "string", "minLength": 1, "maxLength": 128 },
          "roleLevel": { "enum": ["observed", "inferred"] },
          "label": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
          "resourceId": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
          "interactive": { "type": "boolean" },
          "keyboardTarget": { "type": "boolean" },
          "presence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["contextId", "stateId", "source"],
              "properties": {
                "contextId": { "$ref": "#/$defs/id" },
                "stateId": { "$ref": "#/$defs/id" },
                "source": { "enum": ["full", "fast"] }
              }
            }
          },
          "visibleWhen": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["capability", "level", "presentIn", "absentIn", "evidenceIds"],
                "properties": {
                  "capability": { "anyOf": [{ "type": "string", "maxLength": 128 }, { "type": "null" }] },
                  "level": { "enum": ["inferred", "observed", "refuted"] },
                  "presentIn": { "$ref": "#/$defs/ids" },
                  "absentIn": { "$ref": "#/$defs/ids" },
                  "evidenceIds": { "$ref": "#/$defs/ids" }
                }
              }
            ]
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stateId", "contextId", "elementSetHash", "identityTokens", "addedElementKeys", "removedElementKeys", "source", "evidenceIds"],
        "properties": {
          "stateId": { "$ref": "#/$defs/id" },
          "contextId": { "$ref": "#/$defs/id" },
          "elementSetHash": { "$ref": "#/$defs/sha256" },
          "identityTokens": { "type": "array", "items": { "$ref": "#/$defs/text" } },
          "addedElementKeys": { "type": "array", "items": { "$ref": "#/$defs/text" } },
          "removedElementKeys": { "type": "array", "items": { "$ref": "#/$defs/text" } },
          "source": { "enum": ["full", "fast", "none"] },
          "evidenceIds": { "$ref": "#/$defs/ids" }
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrix", "findings", "manualRecords"],
      "properties": {
        "matrix": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["technology", "inspected", "automated", "assistiveVerified"],
            "properties": {
              "technology": { "enum": ["TalkBack", "VoiceOver", "Keyboard"] },
              "inspected": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "method", "findings", "evidenceIds", "level"],
                "properties": {
                  "level": { "const": "inspected" },
                  "status": { "enum": ["present", "issues", "notTested", "unsupported"] },
                  "method": { "$ref": "#/$defs/method" },
                  "findings": { "type": "integer", "minimum": 0 },
                  "evidenceIds": { "$ref": "#/$defs/ids" }
                }
              },
              "automated": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "method", "findings", "evidenceIds", "level"],
                "properties": {
                  "level": { "const": "automated" },
                  "status": { "enum": ["pass", "fail", "unverified", "blocked", "notTested", "unsupported"] },
                  "method": { "$ref": "#/$defs/method" },
                  "findings": { "type": "integer", "minimum": 0 },
                  "evidenceIds": { "$ref": "#/$defs/ids" }
                }
              },
              "assistiveVerified": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "method", "recordIds", "evidenceIds", "level"],
                "properties": {
                  "level": { "const": "assistiveVerified" },
                  "status": { "enum": ["pass", "fail", "notTested", "unsupported"] },
                  "method": { "$ref": "#/$defs/method" },
                  "recordIds": { "$ref": "#/$defs/ids" },
                  "evidenceIds": { "$ref": "#/$defs/ids" }
                }
              }
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ruleId", "technology", "level", "elementKey", "contextId", "stateId", "message", "evidenceIds"],
            "properties": {
              "ruleId": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9.-]{1,63}$" },
              "technology": { "enum": ["TalkBack", "VoiceOver", "Keyboard"] },
              "level": { "enum": ["inspected", "automated"] },
              "elementKey": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
              "contextId": { "$ref": "#/$defs/id" },
              "stateId": { "$ref": "#/$defs/id" },
              "message": { "$ref": "#/$defs/method" },
              "evidenceIds": { "$ref": "#/$defs/ids" }
            }
          }
        },
        "manualRecords": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["recordId", "technology", "stateId", "elementKey", "property", "result", "contextId", "protocolVersion", "evidenceIds"],
            "properties": {
              "recordId": { "$ref": "#/$defs/id" },
              "technology": { "enum": ["TalkBack", "VoiceOver", "Keyboard"] },
              "stateId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
              "elementKey": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
              "property": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9.-]{0,63}$" },
              "result": { "enum": ["Pass", "Fail"] },
              "contextId": { "$ref": "#/$defs/id" },
              "protocolVersion": { "const": "mapcue.a11y-protocol/1" },
              "evidenceIds": { "$ref": "#/$defs/ids" }
            }
          }
        }
      }
    },
    "keyboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicted", "observed"],
      "properties": {
        "predicted": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["contextId", "stateId", "level", "status", "method", "order"],
            "properties": {
              "contextId": { "$ref": "#/$defs/id" },
              "stateId": { "$ref": "#/$defs/id" },
              "level": { "const": "predicted" },
              "status": { "const": "unverified" },
              "method": { "$ref": "#/$defs/method" },
              "order": { "type": "array", "items": { "$ref": "#/$defs/text" } }
            }
          }
        },
        "observed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["contextId", "stateId", "level", "status", "method", "transitions", "order", "unreached", "cycleClosed", "matchesPredicted", "detail", "evidenceIds"],
            "properties": {
              "contextId": { "$ref": "#/$defs/id" },
              "stateId": { "$ref": "#/$defs/id" },
              "level": { "const": "automated" },
              "status": { "enum": ["pass", "fail", "unverified", "blocked"] },
              "method": { "$ref": "#/$defs/method" },
              "transitions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["order", "from", "to"],
                  "properties": {
                    "order": { "type": "integer", "minimum": 1 },
                    "from": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
                    "to": { "$ref": "#/$defs/text" }
                  }
                }
              },
              "order": { "type": "array", "items": { "$ref": "#/$defs/text" } },
              "unreached": { "type": "array", "items": { "$ref": "#/$defs/text" } },
              "cycleClosed": { "type": "boolean" },
              "matchesPredicted": { "anyOf": [{ "type": "boolean" }, { "type": "null" }] },
              "detail": { "anyOf": [{ "$ref": "#/$defs/method" }, { "type": "null" }] },
              "evidenceIds": { "$ref": "#/$defs/ids" }
            }
          }
        }
      }
    },
    "evidenceIds": { "$ref": "#/$defs/ids" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "method": { "type": "string", "minLength": 1, "maxLength": 1000 }
  }
}
